{
  "name": "monitor-bumi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "typecheck:worker": "tsc --noEmit --strict --target ES2022 --module ESNext --moduleResolution Bundler --lib ES2022,DOM worker/index.ts worker/usgs.ts",
    "db:migrate:local": "wrangler d1 migrations apply monitor-bumi --local",
    "db:migrations:list:local": "wrangler d1 migrations list monitor-bumi --local",
    "db:check:local": "wrangler d1 execute monitor-bumi --local --command \"SELECT name FROM sqlite_master WHERE type = 'table' ORDER BY name;\"",
    "deploy:worker": "wrangler deploy",
    "db:test:local": "node scripts/test-local-d1.mjs",
    "test:usgs": "node --test scripts/test-usgs-collector.mjs"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "maplibre-gl": "^6.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.9.2",
    "vite": "^6.4.5",
    "wrangler": "^4.156.1"
  }
}
